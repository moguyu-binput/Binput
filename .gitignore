# ---- 编译过程自动生成的东西 ----
# 每次编译都能重造，存进去只会让仓库越滚越大
bin/
obj/

# 编译脚本跑完留下的临时输出
_b.txt
_build.txt

# 字典的备份 / 中间产物（有一次的处理结果，不是原始素材）
*.bak

# ---- 编辑器的个人文件 ----
.vs/
.idea/
*.user
*.suo

# ---- 发布产物 ----
# 安装包一律由 tools/ 里的打包脚本现生成，不进存档
*.zip
*.exe
*.pdb

# ---- tools/(八套探针 + 打包脚本) 里不该进存档的东西 ----
# 界面截图: 194 张 33MB, 调界面时现拍的, 重拍就有
tools/shots/
# 一次性备份 / 中间产物(2.1.x 那次"拆文件"留下的对照件, 只是为了证明没改行为)
tools/_split0_backup.cs
tools/_split0_dll_before.dll
# Python 字节码缓存
__pycache__/
*.pyc

# ---- 开源之后新加的 ----
# 编辑器 / 系统的杂项
.vscode/
.DS_Store
Thumbs.db
# 万一有人在本地跑过 publish, 产物别进来
_pub_*/
