<Project Sdk="Microsoft.NET.Sdk">

  <!--
    第十套探针: 钉住 PS5 DualSense 的 HID 报告解析。

    为什么要有它: 这一层**没有真手柄就测不了**。手柄插上到底被系统看成什么、
    报告是 64 字节(USB)还是 78 字节(蓝牙)、哪个位是哪颗键 —— 这些只能靠合成报告
    把每个位钉死, 免得改一次挪一格就全错; 真机那部分交给 `hidprobe diag`
    让用户跑一次把原始字节发回来对。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>hidprobe</AssemblyName>
    <RootNamespace>Hidprobe</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Binput.csproj" />
  </ItemGroup>

</Project>
